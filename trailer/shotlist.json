  "logline": "Carry the last fire. Hold back the night.",
  "themes": [
    {
      "name": "FIRE",
      "how": "the flame you carry casts every shadow",
      "card": [
        "Aim the flame: every shadow in the city swings with it.",
        "At the hearth, the fire is your life."
      ]
    },
    {
      "name": "TIME",
      "how": "frozen in the city, running out at the hearth",
      "card": [
        "Light a frozen figure from its true angle: its last ten seconds return.",
        "Ash is time. Spend it to step in, or rewind."
      ]
    },
    {
      "name": "SHADOW",
      "how": "shadows hold you up, and one hunts you",
      "card": [
        "A lit shadow turns solid: walk the bridge your body casts.",
        "And one shadow moves only when you look away."
      ]
    }
  ],
